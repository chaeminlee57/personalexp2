---
import NavBar from '../components/NavBar.astro';
import { ClientRouter } from 'astro:transitions';
import { fade } from 'astro:transitions';
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='generator' content={Astro.generator} />
		<title>Astro Basics</title>
		<ClientRouter />
	</head>
	<body>
		<div
			id='loading-screen'
			class='loading-screen'
			data-initial='true'
			transition:persist
		>
			<span class='loading-text'>Loading<span class='loading-dots'></span></span
			>
		</div>

		<NavBar transition:animate='none' />
		<slot transition:animate={fade({ duration: '0.5s' })} />
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
		min-height: 100dvh;
		background-color: #ebe9d5;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100dvh;
		background-color: #ebe9d5;
		overscroll-behavior: none;
		overflow-x: hidden;
	}

	:root {
		font-family: Georgia, 'Times New Roman', Times, serif;
	}

	.loading-screen {
		position: fixed;
		inset: 0;
		z-index: 9999;
		background-color: #ebe9d5;
		display: flex;
		justify-content: center;
		align-items: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.loading-screen[data-initial] {
		opacity: 1;
		pointer-events: auto;
	}

	.loading-text {
		font-family: Georgia, 'Times New Roman', Times, serif;
		font-size: 1.25rem;
		color: #333;
		letter-spacing: 0.02em;
	}

	.loading-dots::after {
		content: '';
		animation: dots 1.4s steps(4, end) infinite;
	}

	@keyframes dots {
		0% {
			content: '';
		}
		25% {
			content: '.';
		}
		50% {
			content: '..';
		}
		75% {
			content: '...';
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const loadingScreen = document.getElementById('loading-screen');
		if (!loadingScreen) return;

		loadingScreen.removeAttribute('data-initial');
		loadingScreen.classList.remove('visible');
	});
</script>
