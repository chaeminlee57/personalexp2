---
import NavBar from '../components/NavBar.astro';
import { ClientRouter } from 'astro:transitions';
import { fade } from 'astro:transitions';
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='generator' content={Astro.generator} />
		<title>Astro Basics</title>
		<ClientRouter />
	</head>
	<body>
		<!-- Loading screen: visible on first load, delay-shown on client-side navs -->
		<div id='loading-screen' class='loading-screen' data-initial='true'>
			<span class='loading-text'>Loading<span class='loading-dots'></span></span
			>
		</div>

		<NavBar transition:animate='none' />
		<slot transition:animate={fade({ duration: '0.5s' })} />
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
		min-height: 100dvh;
		background-color: #ebe9d5;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100dvh;
		background-color: #ebe9d5;
		overscroll-behavior: none;
		overflow-x: hidden;
	}

	:root {
		font-family: Georgia, 'Times New Roman', Times, serif;
	}

	.loading-screen {
		position: fixed;
		inset: 0;
		z-index: 9999;
		background-color: #ebe9d5;
		display: flex;
		justify-content: center;
		align-items: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	/* First page load: show immediately */
	.loading-screen[data-initial] {
		opacity: 1;
		pointer-events: auto;
	}

	/* When revealed by JS for client-side navs */
	.loading-screen.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.loading-text {
		font-family: Georgia, 'Times New Roman', Times, serif;
		font-size: 1.25rem;
		color: #333;
		letter-spacing: 0.02em;
	}

	.loading-dots::after {
		content: '';
		animation: dots 1.4s steps(4, end) infinite;
	}

	@keyframes dots {
		0% {
			content: '';
		}
		25% {
			content: '.';
		}
		50% {
			content: '..';
		}
		75% {
			content: '...';
		}
	}
</style>

<script>
	let showLoaderTimer: ReturnType<typeof setTimeout> | null = null;

	// When a client-side navigation starts, set a delayed timer to show the loader.
	// If the page loads within 350ms, the loader never appears.
	document.addEventListener('astro:before-preparation', () => {
		const loadingScreen = document.getElementById('loading-screen');
		if (!loadingScreen) return;

		// Clear the initial-load attribute so it starts hidden by default
		loadingScreen.removeAttribute('data-initial');

		showLoaderTimer = setTimeout(() => {
			loadingScreen.classList.add('visible');
		}, 350);
	});

	// When the new page is ready, cancel the timer (if still pending) and hide the loader.
	document.addEventListener('astro:page-load', () => {
		if (showLoaderTimer) {
			clearTimeout(showLoaderTimer);
			showLoaderTimer = null;
		}

		const loadingScreen = document.getElementById('loading-screen');
		if (!loadingScreen) return;

		// Remove both the initial-load attribute and the JS-added class
		loadingScreen.removeAttribute('data-initial');
		loadingScreen.classList.remove('visible');
	});
</script>
