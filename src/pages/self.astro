			<div class={styles.selfBox}>
				<h1 class={styles.selfBoxHeader}>Self</h1>
				<p class={styles.selfBoxContent}>
					Lorem ipsum dolor, sit amet consectetur adipisicing elit. Nostrum
					consectetur iusto quos porro a ex maiores labore laborum dolore modi!
				</p>
			</div>
			<div class={styles.selfBoxImage}>
				<img src='venice.webp' alt='Venice' />
			</div>
		</div>
	</div>
</Layout>
