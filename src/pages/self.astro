---
import Layout from '../layouts/Layout.astro';
import styles from './self.module.scss';
---

<Layout>
	<div class={styles.pageWrapper}>
		<div class={styles.mondrian}>
			<div
				class={`${styles.cell} ${styles.lightGray} ${styles.pulse1}`}
				style='grid-column: 1; grid-row: 1;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 2 / 4; grid-row: 1;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.charcoal} ${styles.pulse2}`}
				style='grid-column: 4; grid-row: 1;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.offWhite} ${styles.pulse3}`}
				style='grid-column: 1 / 3; grid-row: 2;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.pitch} ${styles.pulse4}`}
				style='grid-column: 3; grid-row: 2;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 4; grid-row: 2;'
			>
			</div>

			<div class={styles.albumCard} style='grid-column: 1 / 4; grid-row: 3;'>
				<video autoplay muted loop playsinline>
					<source src='/lysf.webm' type='video/webm' />
				</video>
				<p>My Favorite Album: Lift Your Skinny Fists Like Antennas to Heaven</p>
			</div>
			<div
				class={`${styles.cell} ${styles.lightGray} ${styles.pulse5}`}
				style='grid-column: 4; grid-row: 3;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.charcoal} ${styles.pulse6}`}
				style='grid-column: 1; grid-row: 4;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 2 / 4; grid-row: 4;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.pitch} ${styles.pulse7}`}
				style='grid-column: 4; grid-row: 4;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.offWhite} ${styles.pulse8}`}
				style='grid-column: 1 / 4; grid-row: 5;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.lightGray}`}
				style='grid-column: 4; grid-row: 5;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 1; grid-row: 6;'
			>
			</div>
			<div class={styles.bookCard} style='grid-column: 2 / 5; grid-row: 6;'>
				<img src='slaughterhouse.webp' alt='Slaughterhouse' />
				<p>My Favorite Book: Slaughterhouse-Five</p>
				<p style='color: rgb(186, 186, 186)'>
					Lorem ipsum, dolor sit amet consectetur adipisicing elit. Accusantium,
					fuga!
				</p>
			</div>

			<div
				class={`${styles.cell} ${styles.pitch} ${styles.pulse9}`}
				style='grid-column: 1 / 3; grid-row: 7;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite} ${styles.pulse10}`}
				style='grid-column: 3 / 5; grid-row: 7;'
			>
			</div>

			<div class={styles.pianoCard} style='grid-column: 1 / 4; grid-row: 8;'>
				<img src='children.webp' alt="Children's Corner" />
				<p>My Favorite Suite: Children's Corner</p>
				<p style='color: rgb(186, 186, 186)'>
					Lorem ipsum, dolor sit amet consectetur adipisicing elit. Accusantium,
					fuga!
				</p>
			</div>
			<div
				class={`${styles.cell} ${styles.charcoal} ${styles.pulse11}`}
				style='grid-column: 4; grid-row: 8;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.offWhite} ${styles.pulse12}`}
				style='grid-column: 1; grid-row: 9;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.lightGray} ${styles.pulse1}`}
				style='grid-column: 2; grid-row: 9;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 3; grid-row: 9;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.charcoal} ${styles.pulse2}`}
				style='grid-column: 4; grid-row: 9;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.lightGray} ${styles.pulse3}`}
				style='grid-column: 1; grid-row: 10;'
			>
			</div>
			<div class={styles.placeCard} style='grid-column: 2 / 5; grid-row: 10;'>
				<img src='venice.webp' alt='Venice, Italy' />
				<p>My Favorite Place: Venice, Italy</p>
			</div>

			<div
				class={`${styles.cell} ${styles.offWhite} ${styles.pulse4}`}
				style='grid-column: 1 / 3; grid-row: 11;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.pitch} ${styles.pulse5}`}
				style='grid-column: 3; grid-row: 11;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 4; grid-row: 11;'
			>
			</div>

			<div
				class={`${styles.cell} ${styles.charcoal} ${styles.pulse6}`}
				style='grid-column: 1; grid-row: 12;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.offWhite}`}
				style='grid-column: 2 / 4; grid-row: 12;'
			>
			</div>
			<div
				class={`${styles.cell} ${styles.lightGray} ${styles.pulse7}`}
				style='grid-column: 4; grid-row: 12;'
			>
			</div>
		</div>
	</div>
</Layout>
