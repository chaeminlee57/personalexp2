---
import Layout from '../layouts/Layout.astro';
import styles from './self.module.scss';
---

<Layout>
	<div class={styles.pageWrapper}>
		<div class={styles.hero}>
			<h2 style='font-weight: normal; text-align: center;'>Chaemin Lee</h2>
			<div class={styles.galleryUnit}>
				<img src='Ghibli.webp' alt='Ghibli Scenery' />
				<h3>Ghibli</h3>
				<p>
					I spent the first five years of my life in Japan, obsessively watching
					Studio Ghibli movies. Consequently, they've been an integral part of
					my childhood and the process in which I developed selfhood. I still
					watch Ghibli movies on occasions if I feel my mind is drifting too
					close to pragmatism.
				</p>
			</div>
		</div>
	</div>
</Layout>
