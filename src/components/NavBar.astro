---
import styles from './NavBar.module.scss';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<div
	class={`${styles.navBarWrapper} ${currentPath === '/history' ? styles.borderActive : ''}`}
>
	<div class={styles.imgWrapper}>
		<a data-astro-reload href='/' class={`${currentPath === '/' ? styles.activeImg : ''}`}
			><img
				class={styles.img}
				src={currentPath === '/' ? 'invertcircle.webp' : 'circle.webp'}
				alt=''
			/></a
		>
	</div>
	<a data-astro-reload
		href='/current'
		class={`${styles.gridItem} ${currentPath === '/current' ? styles.active : ''}`}
		>CURRENT</a
	>
	<a data-astro-reload
		href='/film'
		class={`${styles.gridItem} ${currentPath === '/film' ? styles.active : ''}`}
		>FILM</a
	>
	<a data-astro-reload
		href='/history'
		class={`${styles.gridItem} ${currentPath === '/history' ? styles.active : ''}`}
		>HISTORY</a
	>
</div>
